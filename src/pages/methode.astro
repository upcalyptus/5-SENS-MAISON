---
import Maison from '../layouts/Maison.astro';
const heures = [
  ['15:00','L\'arrivée','Les trente premières secondes','Le seuil, le premier regard, la première phrase, le premier parfum. Tout se joue avant la clé.'],
  ['16:30','La chambre','La lumière d\'après-midi','Le linge sous la main, la température du sol, le murmure de la ventilation que personne n\'entend plus.'],
  ['19:00','L\'heure dorée','Le passage au soir','Quand le jour tombe, la lumière de la maison change-t-elle avec lui, ou reste-t-elle celle d\'un bureau ?'],
  ['20:30','La table','Le rituel','La céramique, le rythme du service, le silence entre deux plats, ce que l\'on retient d\'une saveur.'],
  ['23:30','La nuit','Le silence réel','Les bruits techniques, la porte d\'à côté, l\'obscurité véritable. Le sommeil est le premier luxe.'],
  ['07:30','Le réveil','La lumière du matin','Le premier café, la douche, la matière des peignoirs, la façon dont la maison dit bonjour.'],
  ['11:00','Le départ','Ce qui reste','Le dernier mot, le dernier geste. Ce que l\'hôte racontera, ou non, en rentrant.']
];
const etapes = [['01','Immersion','24 à 48 heures, en toute discrétion, dans les conditions réelles d\'un hôte.'],['02','Diagnostic sensoriel','Plus de cent critères : chambres, suites, lobby, spa, tables.'],['03','Indice ICS','Votre score sur 100, dimension par dimension, vos forces, vos priorités.'],['04','Manuel opérationnel','Quoi faire, pourquoi, et comment le déployer avec vos équipes.'],['05','Plan d\'action','La feuille de route 30 / 60 / 90 jours.'],['06','Le Label','Attribué à partir de 88 sur 100.']];
---
<Maison titre="La Méthode" piece="03" image="/assets/img-methode.webp"
  description="La méthode 5 Sens Collection : une immersion de 24 à 48 heures, heure par heure, six étapes et trois livrables prêts à déployer."
  adieu="Une méthode ne vaut que par son indépendance. Voici ce que nous nous interdisons.">
  <Fragment slot="seuil">
    <h1>Quarante-huit heures, heure par heure.</h1>
    <p>Une immersion discrète, vécue comme un hôte l'aurait vécue. Deux heures seulement mobilisent vos équipes.</p>
  </Fragment>
  <section class="salle" style="padding-bottom:0">
    <div class="wrap g12"><p class="num rv" style="grid-column:1/4">I</p>
      <div style="grid-column:4/13"><span class="eyebrow rv">Une immersion, telle qu'elle se vit</span><h2 class="titre-salle" data-mots>Ce que Nina observe, du seuil au départ.</h2></div></div>
  </section>
  <section class="wrap horloge" aria-label="L'immersion heure par heure">
    <div class="cadran"><span class="eyebrow">L'heure de l'immersion</span><p class="h" aria-live="polite">15:00</p><p class="moment">Les trente premières secondes</p></div>
    <div class="etapes">
      {heures.map(([h, t, m, d]) => <div class="etape" data-h={h} data-m={m}><b>{t}</b><p>{d}</p></div>)}
      <p class="petit" style="padding-top:2rem">Horaires donnés à titre d'exemple : chaque immersion suit le rythme réel de la maison.</p>
    </div>
  </section>
  <section class="salle lin">
    <div class="wrap">
      <div class="g12"><p class="num rv" style="grid-column:1/4">II</p><div style="grid-column:4/13"><span class="eyebrow rv">Six étapes</span><h2 class="titre-salle" data-mots>Sans zone d'ombre.</h2></div></div>
      <ol class="liste-num" style="margin-top:4rem">{etapes.map(([n, t, d]) => <li class="rv"><span class="n">{n}</span><b>{t}</b><p>{d}</p></li>)}</ol>
    </div>
  </section>
  <section class="salle">
    <div class="wrap g12" style="align-items:center">
      <figure class="revele" style="grid-column:1/8"><img src="/assets/img-methode.webp" alt="Les livrables imprimés de l'audit" loading="lazy" width="1600" height="1070"><figcaption class="legende"><span>Les livrables</span><span>Remis en main propre</span></figcaption></figure>
      <div style="grid-column:9/13"><span class="eyebrow rv">Ce que vous recevez</span><h2 class="rv" style="font-size:clamp(2rem,3vw,2.8rem);line-height:1.08">Trois livrables, prêts à déployer.</h2>
        <ol class="liste-num" style="margin-top:2rem">
          <li class="rv" style="grid-template-columns:1fr"><b style="font-size:1.35rem">L'indice ICS</b><p>Dimension par dimension, comparable dans le temps.</p></li>
          <li class="rv" style="grid-template-columns:1fr"><b style="font-size:1.35rem">Le manuel opérationnel</b><p>Et le tableau des irritants, classés par urgence.</p></li>
          <li class="rv" style="grid-template-columns:1fr"><b style="font-size:1.35rem">La feuille de route</b><p>30 / 60 / 90 jours : les gains immédiats, puis les chantiers de fond.</p></li>
        </ol></div>
    </div>
  </section>
</Maison>
