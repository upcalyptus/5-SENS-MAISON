---
import Maison from '../layouts/Maison.astro';
const jamais = [['Vendre un résultat','Une maison paie son évaluation, jamais son Label. Le résultat ne se négocie pas.'],['Prévenir les équipes',"La date de l'immersion n'est connue que de la direction. Ce que nous observons est ce que vivent vos hôtes."],['Évaluer des personnes','Nous évaluons une expérience, pas des collaborateurs. Aucun nom n\'apparaît dans nos rapports.'],['Publier sans accord',"Les résultats détaillés restent confidentiels. Seule l'attribution du Label peut être rendue publique, et l'indice avec votre accord."],['Évaluer un proche','Un expert lié à une maison, par un contrat ou une relation personnelle, ne l\'évalue pas.']];
---
<Maison titre="La Charte d'indépendance" piece="04" image="/assets/img-vue.webp"
  description="La Charte d'indépendance de 5 Sens Collection : ce que nous nous interdisons, pour que le Label ne puisse jamais s'acheter."
  adieu="Vous savez désormais ce que nous faisons, et ce que nous ne ferons jamais. Il reste à nous rencontrer.">
  <Fragment slot="seuil">
    <h1>Ce que l'on ne peut pas acheter.</h1>
    <p>Un label n'a de valeur que s'il est incontestable. Voici les engagements qui le rendent tel.</p>
  </Fragment>
  <section class="salle">
    <div class="wrap">
      <div class="g12"><p class="num rv" style="grid-column:1/4">I</p><div style="grid-column:4/13"><span class="eyebrow rv">Ce que nous ne ferons jamais</span><h2 class="titre-salle" data-mots>Cinq interdits.</h2></div></div>
      <ol class="liste-num" style="margin-top:4rem">{jamais.map(([a, b], i) => <li class="rv"><span class="n">{String(i + 1).padStart(2, '0')}</span><b>{a}</b><p>{b}</p></li>)}</ol>
    </div>
  </section>
  <section class="salle lin">
    <div class="wrap g12"><p class="num rv" style="grid-column:1/4">II</p>
      <div style="grid-column:4/9"><span class="eyebrow rv">Si vous contestez</span><h2 class="titre-salle" data-mots>Un résultat se discute. Il ne s'efface pas.</h2></div>
      <div style="grid-column:9/13;align-self:end"><p class="lead rv">Une maison peut demander, dans les <span class="a-valider">[30]</span> jours suivant la restitution, un nouvel examen des critères qu'elle conteste, mené par un second expert qui n'a pas participé à l'immersion.</p></div></div>
  </section>
  <section class="salle">
    <div class="wrap" style="text-align:center;max-width:980px">
      <span class="eyebrow rv">L'engagement</span>
      <p class="manifeste" data-mots>Chaque Label attribué pourra être défendu, critère par critère, devant la maison qui l'a reçu comme devant celle qui ne l'a pas obtenu.</p>
      <p class="rv" style="margin-top:3rem"><span class="signature">Nina Vienney</span></p>
      <p class="eyebrow rv" style="margin-top:1rem">Fondatrice · <span class="a-valider">[date de signature]</span></p>
    </div>
  </section>
</Maison>
